SECRET_KEY=change-me
DEMO_USER_PASSWORD=change-me
DATABASE_URL=sqlite:///instance/portal.db
PROMETHEUS_BASE_URL=http://192.168.10.10:9090
PROMETHEUS_TIMEOUT_SECONDS=3
PROMETHEUS_BEARER_TOKEN=
PROMETHEUS_VERIFY_SSL=true
AUTOMATION_EXECUTOR=ansible
AUTO_REMEDIATION_ENABLED=false
AUTO_REMEDIATION_COOLDOWN_SECONDS=120
AUTO_REMEDIATION_MAX_RETRIES=1
ANSIBLE_CONTROLLER_HOST=192.168.10.10
ANSIBLE_CONTROLLER_USER=
# Private key on this machine, used only to SSH to MON01. Leave empty to use the default key.
# AZURE01's key stays in /etc/ansible/hosts on MON01 and is not set here.
ANSIBLE_CONTROLLER_KEY=
ANSIBLE_TIMEOUT_SECONDS=90
GRAFANA_BASE_URL=http://192.168.10.10:3000
ALERTMANAGER_WEBHOOK_TOKEN=
JOB_OUTPUT_MAX_CHARS=4000
FLASK_DEBUG=1

# Microsoft Entra ID (E5 Developer). Leave blank until the App Registration exists.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:5000/auth/callback

# Alert mail uses Microsoft Graph app-only: POST /users/{GRAPH_SENDER_MAILBOX}/sendMail.
# Recipients are the distribution groups, one severity per event.
NOTIFY_ENABLED=false
GRAPH_SENDER_MAILBOX=
GRAPH_MAIL_SENDER=
ALERT_RECIPIENTS=
NOTIFY_RECIPIENTS=
ALERT_RECIPIENT_CRITICAL=
ALERT_RECIPIENT_WARNING=
ALERT_RECIPIENT_INFO=
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cloud target. Infra supplies the address, exporter, and playbook path.
AZURE01_IP=
AZURE01_EXPORTER=
AZURE01_NGINX_URL=
AZURE01_PLAYBOOK=~/ansible/playbooks/restart-azure-nginx.yml
